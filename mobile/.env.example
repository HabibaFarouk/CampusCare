# Copy to `.env`. Anything prefixed with EXPO_PUBLIC_ is inlined into the
# JS bundle at build time and is NOT a secret — it ends up on the phone.
# Our backend is what keeps the real secrets, so that's fine.

# In iOS simulator:    http://localhost:3000
# In Android emulator: http://10.0.2.2:3000
# On a real phone:     http://<your-machine-LAN-IP>:3000   (same Wi-Fi as laptop)
EXPO_PUBLIC_API_URL=http://localhost:3000
