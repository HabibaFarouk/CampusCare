generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  phoneNumber String?
  isActive  Boolean  @default(true)
  notifications Notification[]
  auditLogs     AuditLog[]
  tickets   Ticket[] @relation("UserTickets")
  assigned  Ticket[] @relation("AssignedTickets")
  comments  Comment[] @relation("UserComments")
  createdAt DateTime @default(now())
}

model Ticket {
  id                Int       @id @default(autoincrement())
  title             String
  description       String
  status            Status    @default(SUBMITTED)
  category          Category
  imageUrl          String?
  completionPhotoUrl String?
  location          String
  createdBy         User      @relation("UserTickets", fields: [createdById], references: [id])
  createdById       Int
  assignedTo        User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedToId      Int?
  auditLogs     AuditLog[]
  comments          Comment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  Int
  worker    User     @relation("UserComments", fields: [workerId], references: [id])
  workerId  Int
  createdAt DateTime @default(now())
}

// ADD THESE TO SCHEMA.PRISMA FIRST

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  changedById Int
  changedBy User     @relation(fields: [changedById], references: [id])
  action    String   // Example: "STATUS_CHANGED", "ASSIGNED_WORKER"
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

enum Role {
  MEMBER 
  FACILITY_MANAGER
  WORKER
  ADMIN
}

enum Status {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  FINISHED
  FINALIZED
  RESOLVED
  CANCELLED
}

enum Category {
  MAINTENANCE
  CLEANLINESS
  SUSTAINABILITY
}